# Copy this file to .env and fill in the values. .env is gitignored.

# LLM providers (free tiers only)
GROQ_API_KEY=
GEMINI_API_KEY=

# PostgreSQL in Docker (see docker-compose.yml)
POSTGRES_USER=pr_reviewer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pr_reviewer
POSTGRES_PORT=5432

# LangSmith tracing (set LANGSMITH_TRACING=true to turn it on)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pr-reviewer
